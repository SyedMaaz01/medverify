# MedVerify Environment Configuration
# Copy this file to .env and fill in the values

# Security
# Generate a strong random key for production: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production

# JWT Algorithm
ALGORITHM=HS256

# Access token expiry in minutes (default: 1 year)
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Database
# For local development with SQLite (no PostgreSQL needed):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=medverify
# DB_USER=postgres
# DB_PASSWORD=postgres

# For production PostgreSQL:
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_NAME=medverify
# DB_USER=medverify_user
# DB_PASSWORD=your-strong-password

# Database URL (alternative to individual DB_* settings)
# SQLALCHEMY_DATABASE_URL=postgresql://user:pass@host:port/dbname

# DRAP Integration (for production)
# DRAP_API_URL=https://api.drap.gov.pk
# DRAP_API_KEY=your-drap-api-key

# Frontend URL (for CORS)
# FRONTEND_URL=https://medverify.app